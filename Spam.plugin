# -*- coding: utf-8 -*-
"""Spam command parser for AyuGram.

This safe build recognizes: !Spaw <count> <text>
It cancels the command and shows a local preview only.
It intentionally does not send repeated messages.
"""

import re

__id__ = "spaw_preview"
__name__ = "Spaw Preview"
__description__ = "Parses !Spaw count text and shows a local preview; no mass sending."
__author__ = "loslam-del"
__version__ = "1.1.0"
__min_version__ = "12.5.1"
__category__ = "tools"

from base_plugin import BasePlugin
from hook_utils import hook

COMMAND_RE = re.compile(r"^!Spaw\s+(\d{1,3})\s+(.+)$", re.IGNORECASE)
MAX_PREVIEW_COUNT = 100


def _get_text(ctx):
    """Read outgoing text from the mobile hook context without assuming its type."""
    for candidate in (
        getattr(ctx, "message", None),
        getattr(ctx, "text", None),
        getattr(ctx, "message_text", None),
    ):
        if isinstance(candidate, str):
            return candidate
        if candidate is not None:
            for attr in ("text", "message"):
                value = getattr(candidate, attr, None)
                if isinstance(value, str):
                    return value
    return ""


class SpawPreviewPlugin(BasePlugin):
    def on_plugin_load(self):
        self.log("[SpawPreview] loaded")

    @hook("on_message_sending")
    def on_message_sending(self, ctx):
        try:
            text = _get_text(ctx).strip()
            match = COMMAND_RE.match(text)
            if not match:
                return

            requested_count = int(match.group(1))
            body = match.group(2).strip()
            if not body:
                self.toast("Spaw: укажи текст после количества.")
                ctx.cancel = True
                return

            count = max(1, min(requested_count, MAX_PREVIEW_COUNT))

            # Consume the command so it is not accidentally sent as a normal message.
            ctx.cancel = True

            if requested_count > MAX_PREVIEW_COUNT:
                self.toast(
                    "Предпросмотр: "
                    + str(count)
                    + " повторов (лимит 100). Массовая отправка отключена."
                )
            else:
                self.toast(
                    "Команда распознана: "
                    + str(count)
                    + " × «"
                    + body[:60]
                    + ("…»" if len(body) > 60 else "»")
                    + ". Это только предпросмотр, отправка отключена."
                )

            self.log(
                "[SpawPreview] parsed count="
                + str(count)
                + ", text_length="
                + str(len(body))
            )
        except Exception as exc:
            try:
                ctx.cancel = True
            except Exception:
                pass
            self.log("[SpawPreview] command handler error: " + str(exc))
            self.toast("Spaw Preview: ошибка разбора команды.")

    def on_plugin_unload(self):
        self.log("[SpawPreview] unloaded")
