# -*- coding: utf-8 -*-
import re
import time
import threading

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import send_message

__id__ = "spaw_repeat"
__name__ = "Spaw"
__description__ = "!spaw N text - sends text N times"
__author__ = "loslam-del"
__version__ = "2.0.0"
__app_version__ = ">=12.5.1"
__category__ = ["tools"]

COMMAND_RE = re.compile(r"^!spaw\s+(\d{1,3})\s+(.+)$", re.IGNORECASE | re.DOTALL)
MAX_COUNT = 20     # защита от бана за флуд
DELAY = 0.7        # пауза между сообщениями, сек


class SpawPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.logger.info("Spaw loaded")

    def on_send_message_hook(self, account, params):
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return HookResult()

        match = COMMAND_RE.match(message.strip())
        if not match:
            return HookResult()

        count = min(int(match.group(1)), MAX_COUNT)
        body = match.group(2).strip()
        if count < 1 or not body or body.lower().startswith("!spaw"):
            return HookResult()

        peer = getattr(params, "peer", None)

        def worker():
            for _ in range(count - 1):
                time.sleep(DELAY)
                try:
                    send_message({"peer": peer, "message": body})
                except Exception as e:
                    self.logger.error(f"Spaw send error: {e}")
                    break

        # первое сообщение: подменяем текст команды на сам текст
        params.message = body
        if count > 1:
            threading.Thread(target=worker, daemon=True).start()

        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def on_plugin_unload(self):
        self.logger.info("Spaw unloaded")
