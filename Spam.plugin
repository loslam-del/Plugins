# -*- coding: utf-8 -*-
"""Safe local preview for the !Spaw command.

This plugin only recognizes the command and cancels it before sending.
It never sends repeated messages.
"""

import re

from base_plugin import BasePlugin, HookResult, HookStrategy

__id__ = "spaw_preview"
__name__ = "Spaw Preview"
__description__ = "Recognizes !Spaw count text and logs a local preview; does not send messages."
__author__ = "loslam-del"
__version__ = "1.2.0"
__min_version__ = "12.5.1"
__category__ = ["tools"]

COMMAND_RE = re.compile(r"^!spaw(?:\s+(\d{1,3})\s+(.+))?$", re.IGNORECASE)
MAX_PREVIEW_COUNT = 100


class SpawPreviewPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.logger.info("Spaw Preview loaded; outgoing command preview hook registered")

    def on_send_message_hook(self, account: int, params) -> HookResult:
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return HookResult()

        raw_text = message.strip()
        if not raw_text.lower().startswith("!spaw"):
            return HookResult()

        match = COMMAND_RE.fullmatch(raw_text)
        if not match or not match.group(1) or not match.group(2).strip():
            self.logger.info("Spaw Preview: invalid command syntax; command canceled")
            return HookResult(strategy=HookStrategy.CANCEL)

        requested_count = int(match.group(1))
        preview_count = max(1, min(requested_count, MAX_PREVIEW_COUNT))
        body = match.group(2).strip()

        self.logger.info(
            "Spaw Preview only: requested_count=%s, preview_count=%s, text=%r",
            requested_count,
            preview_count,
            body[:120],
        )
        return HookResult(strategy=HookStrategy.CANCEL)

    def on_plugin_unload(self):
        self.logger.info("Spaw Preview unloaded")
